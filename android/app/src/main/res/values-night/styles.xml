<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark system appearance: light system-bar icons over the dark window until the web app sets the
         person's own choice through SystemBars.setStyle (lib/appearance/client.ts). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/zest_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:background">@null</item>
    </style>
</resources>
