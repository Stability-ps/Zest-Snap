# REQUIRED NOW: Vercel server environment only. Never prefix secrets NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SCANNING_ENABLED=true
LOCAL_HOURLY_SCAN_LIMIT=10

# CLOUD ACTIVATION: dedicated Zest Snap project only. Set both public values together.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (or legacy service_role key) required for usage metering,
# once-only rewards and account deletion. Never expose in a browser bundle.
SUPABASE_SECRET_KEY=
# Optional emergency rollback. Absent/true uses cloud when public config is valid.
NEXT_PUBLIC_CLOUD_ENABLED=true

# OPTIONAL distributed local-mode abuse protection (Upstash REST-compatible Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# FUTURE integrations remain disabled. These placeholders do not enable a feature.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Optional operational cost estimates for the selected model; no guessed prices.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
